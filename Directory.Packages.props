<Project>

  <!--
    Every package version in the solution, declared once.

    The project files argue that versions are pinned exactly so the build is reproducible and a
    compromised release cannot be picked up silently. That argument is weaker when the same
    version string is repeated across five project files, because the failure mode is one of
    them being missed during an upgrade, which is how a solution ends up loading two versions
    of the same assembly. Central package management is the first-party mechanism for the
    position this repo already takes.

    Projects reference packages by name only; the version comes from here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    Transitive, pinned deliberately rather than accepted as resolved.

    Microsoft.AspNetCore.OpenApi 10.0.x depends on Microsoft.OpenApi 2.0.0, which is affected by
    CVE-2026-49451: an OpenAPI document containing a circular schema reference sends the parser
    into unbounded recursion and terminates the process. A StackOverflowException cannot be
    caught, so there is no defending against it at runtime. It is fixed in 2.7.5, and the parent
    package has not moved.

    Because CentralPackageTransitivePinningEnabled is on, naming a version here raises the
    transitive to it without needing a PackageReference in any project, which is precisely the
    situation that feature exists for. Kept on the 2.x line so the parent's expectations hold.

    This project does not parse untrusted OpenAPI documents, so the practical exposure is close
    to nil; it is pinned anyway, because "we were not reachable by that one" is a worse answer to
    an auditor than "we patched it".
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <!-- Test-only. None of these ship in the container image. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
