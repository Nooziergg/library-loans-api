# Normalize line endings so the repo behaves identically on Mac, Linux and Windows.
* text=auto

# These are consumed by Linux containers and shells. CRLF would break them.
*.sh          text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
