{
  "Logging": {
    "LogLevel": {
      "Default": "Information",

      // A decision, not an inherited default. The hosting layer logs two lines per request at
      // Information ("Request starting" / "Request finished") plus routing and endpoint chatter,
      // all of which is restating what the single HttpLogging line below already says. Raise this
      // to Information to see the framework's view when diagnosing routing or model binding, where
      // its lines say something the summary does not.
      //
      // Comments are legal here: the JSON configuration provider parses with comment handling set
      // to skip.
      "Microsoft.AspNetCore": "Warning",

      // Exempted from the line above, and the exemption is the whole point. UseHttpLogging writes
      // the one line per request this service keeps — method, path, status, duration — and its
      // category sits under Microsoft.AspNetCore, so the Warning above would silence it. That is
      // not hypothetical: turning a category down and leaving nothing in its place is exactly how
      // this service previously ran with no request logging at all, which went unnoticed until it
      // was looked for. Deleting this line reproduces that.
      "Microsoft.AspNetCore.HttpLogging": "Information",

      // EF Core logs the text of every command it executes at Information. That is two or three
      // lines per request restating what the request line already says, it scrolls the log a
      // reviewer is reading, and at volume it is the single largest thing in a log bill. Parameter
      // values are already redacted — EnableSensitiveDataLogging is off — but the shape of a query
      // is still more than a default log stream should carry. Set this to Information while
      // diagnosing a query; that is the intended way to see SQL, rather than leaving it on.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
