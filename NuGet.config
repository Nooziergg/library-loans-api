<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned so the build is reproducible on any machine, in CI, and inside Docker,
  regardless of machine-level or Visual Studio package sources.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
