<Project>

  <!--
    Shared build settings for every project in the solution. Declared once here rather than
    repeated per project, so retargeting the framework is a one-line change instead of a
    six-file change that can be done incompletely.

    Warnings are errors: a warning that survives review becomes a warning nobody reads.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      TreatWarningsAsErrors only covers the C# compiler. Package and assembly-resolution
      problems are reported by MSBuild, so without this an unresolvable version conflict
      between two dependencies passes a build that claims to treat warnings as errors —
      which is exactly the kind of quiet gap this project is meant not to have.
    -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>

    <!--
      Fail the build on any package with a known vulnerability, direct or transitive.

      NuGet audit reports these as NU1901-NU1904 warnings, which the setting above turns into
      errors. Auditing transitively as well as directly is the part that matters: a vulnerability
      is far more likely to arrive through a dependency you never chose than through one you did,
      and combined with central package management a transitive can be pinned up to a patched
      version without waiting for its parent to move.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
